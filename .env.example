# CinePass - Environment Variables Configuration Template
# Copy this file to '.env' in local development environment

# Django Core Settings
SECRET_KEY=django-insecure-cinepass-production-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=cinepass-backend.onrender.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL URL format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://cinepass_user:cinepass_password@localhost:5432/cinepass_db

# TMDb API Integration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SMTP Email Configuration (Gmail / SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=CinePass <noreply@cinepass.com>

# CORS & CSRF Configuration for Vercel Frontend
FRONTEND_URL=https://cinepass-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://cinepass-frontend.vercel.app,http://localhost:3000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://cinepass-frontend.vercel.app,https://*.onrender.com

# Logging & Security
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False

